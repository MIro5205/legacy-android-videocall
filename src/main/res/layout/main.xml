<?xml version="1.0" encoding="utf-8"?>
<!--
    Two screens in one FrameLayout. Only one visible at a time.
    White, Google-style. ScrollView guards against X10 Mini Pro clipping.
    No PopupWindow — call controls slide up from bottom as a simple View.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#FFFFFFFF">

    <!-- ═══════════════════════════════════════════════
         PRE-CALL SCREEN
         ═══════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/preCallLayout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#FFFFFFFF"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Logo mark — simple coloured circle + wordmark, zero weight -->
            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="&#9990;"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:gravity="center"
                android:background="@drawable/logo_bg"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X10 Call"
                android:textColor="#FF1A73E8"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#FF5F6368"
                android:textSize="12sp"
                android:gravity="center"
                android:minHeight="18dp"
                android:layout_marginBottom="16dp" />

            <!-- Camera self-view -->
            <SurfaceView
                android:id="@+id/localPreview"
                android:layout_width="128dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp" />

            <!-- Room code card — hidden until host taps Start -->
            <LinearLayout
                android:id="@+id/roomCodeCard"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share this code"
                    android:textColor="#FF5F6368"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/roomCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF1A73E8"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0" />

            </LinearLayout>

            <!-- START CALL — solid blue pill -->
            <TextView
                android:id="@+id/hostBtn"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:text="Start a call"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_primary"
                android:layout_marginBottom="12dp" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#FFE8EAED" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  or join  " android:textColor="#FF9AA0A6" android:textSize="11sp" />
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#FFE8EAED" />
            </LinearLayout>

            <!-- Code input -->
            <EditText
                android:id="@+id/roomInput"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:hint="Room code"
                android:textColorHint="#FF9AA0A6"
                android:textColor="#FF202124"
                android:textSize="18sp"
                android:inputType="number"
                android:maxLength="6"
                android:gravity="center"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="10dp" />

            <!-- JOIN CALL — outlined pill -->
            <TextView
                android:id="@+id/joinBtn"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:text="Join"
                android:textColor="#FF1A73E8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_secondary" />

        </LinearLayout>
    </ScrollView>


    <!-- ═══════════════════════════════════════════════
         IN-CALL SCREEN
         Full-screen video. Controls are a plain View
         at the bottom — no PopupWindow, no offset bugs.
         ═══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/inCallLayout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone">

        <!-- Remote video — fills every pixel -->
        <ImageView
            android:id="@+id/remoteView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:background="#FF000000" />

        <!-- Stats: elapsed + data, top-right, text shadow only -->
        <TextView
            android:id="@+id/callStatsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:text="0:00 · 0B"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:shadowColor="#AA000000"
            android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />

        <!--
            CALL CONTROLS — always at the bottom, initially GONE.
            Toggled by the hardware Menu key (onKeyDown) AND by tapping the video.
            This completely avoids PopupWindow positioning bugs on legacy Android.
        -->
        <LinearLayout
            android:id="@+id/callControls"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/controls_bg"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone">

            <!-- Row 1: Mute + Camera toggle -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/muteBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Mute"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ctrl_btn_bg"
                    android:layout_marginRight="6dp" />

                <TextView
                    android:id="@+id/cameraBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Cam off"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ctrl_btn_bg"
                    android:layout_marginLeft="6dp" />

            </LinearLayout>

            <!-- Row 2: Rotate + End call -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/rotateBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Rotate"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ctrl_btn_bg"
                    android:layout_marginRight="6dp" />

                <TextView
                    android:id="@+id/hangupBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="End call"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ctrl_btn_red"
                    android:layout_marginLeft="6dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
