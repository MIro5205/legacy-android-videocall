<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#FFFFFFFF">

    <!-- PRE-CALL SCREEN -->
    <ScrollView
        android:id="@+id/preCallLayout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#FFFFFFFF"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X10 Call"
                android:textColor="#FF1A73E8"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Status line -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#FF5F6368"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <!-- Self camera preview -->
            <SurfaceView
                android:id="@+id/localPreview"
                android:layout_width="128dp"
                android:layout_height="96dp"
                android:layout_marginBottom="14dp" />

            <!-- Room code card, shown only after hosting -->
            <LinearLayout
                android:id="@+id/roomCodeCard"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your room code"
                    android:textColor="#FF5F6368"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/roomCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF1A73E8"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- START CALL -->
            <TextView
                android:id="@+id/hostBtn"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:text="Start a call"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_primary"
                android:layout_marginBottom="10dp" />

            <!-- OR divider -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#FFE0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  or  "
                    android:textColor="#FF9AA0A6"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#FFE0E0E0" />

            </LinearLayout>

            <!-- Code input -->
            <EditText
                android:id="@+id/roomInput"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:hint="6-digit room code"
                android:textColorHint="#FF9AA0A6"
                android:textColor="#FF202124"
                android:textSize="16sp"
                android:inputType="number"
                android:maxLength="6"
                android:gravity="center"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="10dp" />

            <!-- JOIN CALL -->
            <TextView
                android:id="@+id/joinBtn"
                android:layout_width="fill_parent"
                android:layout_height="48dp"
                android:text="Join call"
                android:textColor="#FF1A73E8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_secondary" />

        </LinearLayout>
    </ScrollView>

    <!-- IN-CALL SCREEN — pure video + hidden menu -->
    <FrameLayout
        android:id="@+id/inCallLayout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/remoteView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:background="#FF000000" />

        <TextView
            android:id="@+id/callStatsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:text="0:00 · 0KB"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- ⋮ button — dark pill, always visible over video -->
        <TextView
            android:id="@+id/menuAnchor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="10dp"
            android:text="&#8942;"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@drawable/menu_fab_bg" />

    </FrameLayout>

</FrameLayout>
